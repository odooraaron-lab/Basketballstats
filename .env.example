# ---- Owner login (always works, even without a database) -------------------
APP_USERNAME=aaron
APP_PASSWORD=change-me
# Long random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.myqr.co.nz
SUPPORT_EMAIL=support@myqr.co.nz
# NEXT_PUBLIC_DISPLAY_TZ=Pacific/Auckland

# ---- Members database (Postgres; Neon free tier works) ---------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Stripe (NZ$9.99/month) -------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: use a Price you created in Stripe instead of the inline NZ$9.99 price
# STRIPE_PRICE_ID=price_...
# Optional free trial length in days (0 or blank = no trial)
STRIPE_TRIAL_DAYS=7

# ---- Email (password resets, receipts) via Resend -------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Quick Read <hello@myqr.co.nz>

# ---- Horse racing -------------------------------------------------------------
# Lets Vercel Cron run the nightly racing import (/api/cron/racing). Any long random string.
CRON_SECRET=replace-with-a-long-random-string
# Optional: Entain affiliate partner ID if you register with TAB NZ / Ladbrokes affiliates
# RACING_PARTNER_ID=
# Optional: override the racing feed (comma-separated, tried in order)
# RACING_API_BASES=https://api.tab.co.nz/affiliates/v1,https://api.ladbrokes.com.au/affiliates/v1

# ---- Optional ----------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...   # Odds check reads screenshots with Claude vision
